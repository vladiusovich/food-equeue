# Used by docker-compose.yml to configure postgres, api and web together.
# Copy to .env and fill in real values before running `docker compose up`.

# --- Postgres / api DB connection ---
DB_USER=food_equeue
DB_PASSWORD=change_me
DB_NAME=food_equeue

# --- api ---
# IS_DEV=true seeds the database with sample branches/products/orders on
# startup (see seeder.service.ts) — handy for a fresh local Postgres volume.
IS_DEV=true
IS_LOCAL_NETWORK_DEPLOY=false
CLIENT_APP_URL=http://localhost:3001
CLIENT_APP_LOCAL_NETWORK_URL=http://192.168.100.11:3001
JWT_SECRET=change_me
JWT_EXPIRES_IN=3600s

# --- web (baked into the static build via $env/static/public — changing
# these requires `docker compose build web`, not just a restart) ---
PUBLIC_FOOD_SERVER_URL=http://localhost:3000
PUBLIC_FOOD_SERVER_SOCKET_URL=http://localhost:3000/customers
